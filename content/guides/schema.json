{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "WebTomata guide frontmatter",
	"description": "YAML frontmatter at the top of a Markdown file in content/guides/<id>.md.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"id",
		"order",
		"topic",
		"readingMinutes",
		"cardTitle",
		"title",
		"summary"
	],
	"properties": {
		"schemaVersion": {
			"type": "integer",
			"const": 1
		},
		"id": {
			"description": "The slug of the guide. Must equal the filename without .md and matches the pattern field in content/questions/.",
			"type": "string",
			"pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
			"maxLength": 64
		},
		"order": {
			"description": "Position in the guide list and next/previous sequence, starting from 1.",
			"type": "integer",
			"minimum": 1,
			"maximum": 100
		},
		"topic": {
			"description": "Topic filter chip on /panduan.",
			"enum": ["dfsm", "ndfsm", "regex", "operasi"]
		},
		"readingMinutes": {
			"description": "Estimated reading time in minutes.",
			"type": "integer",
			"minimum": 1,
			"maximum": 60
		},
		"cardTitle": { "$ref": "#/definitions/text120" },
		"title": { "$ref": "#/definitions/text120" },
		"summary": { "$ref": "#/definitions/text300" },
		"references": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"rich": { "$ref": "#/definitions/sections" },
				"sipser": { "$ref": "#/definitions/sections" }
			}
		}
	},
	"definitions": {
		"text": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id"],
			"properties": {
				"id": { "type": "string", "minLength": 1 },
				"en": { "type": "string", "minLength": 1 }
			}
		},
		"text120": {
			"allOf": [
				{ "$ref": "#/definitions/text" },
				{
					"properties": {
						"id": { "maxLength": 120 },
						"en": { "maxLength": 120 }
					}
				}
			]
		},
		"text300": {
			"allOf": [
				{ "$ref": "#/definitions/text" },
				{
					"properties": {
						"id": { "maxLength": 300 },
						"en": { "maxLength": 300 }
					}
				}
			]
		},
		"sections": {
			"type": "array",
			"maxItems": 10,
			"items": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" }
		}
	}
}
